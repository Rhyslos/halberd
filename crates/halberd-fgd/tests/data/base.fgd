// Halberd test data: a small FGD written for these tests, in the style of
// the Source SDK's files.

@mapsize(-16384, 16384)

@BaseClass = Targetname
[
	targetname(target_source) : "Name" : : "The name that other entities refer to this entity by."
	input Kill(void) : "Removes this entity from the world."
	output OnUser1(void) : "Fired in response to FireUser1 input."
]

@BaseClass = Angles
[
	angles(angle) : "Pitch Yaw Roll (Y Z X)" : "0 0 0" : "This entity's orientation in the world."
]

@BaseClass = RenderFields
[
	rendermode(choices) : "Render Mode" : 0 : "Used to set a non-standard rendering mode." =
	[
		0: "Normal"
		1: "Color"
		10: "Don't Render"
	]
	renderamt(integer) : "FX Amount (0 - 255)" : 255
	rendercolor(color255) : "FX Color (R G B)" : "255 255 255"
]

@BaseClass base(Targetname, Angles) = Light
[
	_light(color255) : "Brightness" : "255 255 255 200" : "Color and brightness of the light."
	style(choices) : "Appearance" : 0 =
	[
		0 : "Normal"
		10: "Fluorescent flicker"
	]
	input TurnOn(void) : "Turn the light on."
	input TurnOff(void) : "Turn the light off."
]
